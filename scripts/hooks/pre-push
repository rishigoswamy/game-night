#!/bin/sh
# Runs before every `git push` (installed with: npm run setup-hooks). The same checks as the CI pipeline (docs/CI.md):
# build check, unit tests with the coverage gate, end-to-end tests, package (zip + smoke test). If any fails, nothing is pushed.
# Skip once (e.g. pushing only docs in a hurry): git push --no-verify
cd "$(git rev-parse --show-toplevel)" || exit 1
zero=0000000000000000000000000000000000000000
base="" any=""
while read -r _lref lsha _rref rsha; do
  [ "$lsha" = "$zero" ] && continue                       # deleting a remote branch: nothing to check
  any=yes
  if [ "$rsha" != "$zero" ]; then base="$rsha"; else base=$(git merge-base "$lsha" origin/main 2>/dev/null || true); fi
done
[ -z "$any" ] && exit 0
if [ -n "$(git status --porcelain --untracked-files=no)" ]; then
  echo "pre-push: you have uncommitted changes. The checks test the files on disk, so commit or stash them first."
  exit 1
fi
echo "pre-push: build check, unit tests + coverage, end-to-end tests, package (about 6 minutes)…"
if node scripts/ci.js --label "git push" ${base:+--base "$base"}; then
  echo "pre-push: ✓ all checks passed"
else
  echo "pre-push: ✗ checks failed, so nothing was pushed. Fix them and push again (git push --no-verify skips the checks)."
  exit 1
fi
